  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "homepage": "https://docs.anthropic.com/en/docs/claude-code",
      "license": "proprietary",
      "launchCommand": "claude",
      "verified": false,
      "note": "Windows recommended path is WSL2 (sandbox + MCP ecosystem), per design D2.",
      "platforms": {
        "windows": {
          "recommended": "wsl",
          "choices": {
            "wsl": {
              "label": "WSL2 内安装（官方推荐）",
              "command": "wsl -e bash -lc \"curl -fsSL https://claude.ai/install.sh | bash\"",
              "requires": ["wsl", "git"],
              "defaultWorkDir": "~/agents/claude-code"
            },
            "native": {
              "label": "Windows 原生（PowerShell）",
              "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://claude.ai/install.ps1 | iex\"",
              "requires": ["git"],
              "defaultWorkDir": "%USERPROFILE%\\agents\\claude-code"
            }
          }
        },
        "macos": {
          "recommended": "native",
          "choices": {
            "native": {
              "label": "原生安装",
              "command": "curl -fsSL https://claude.ai/install.sh | bash",
              "requires": ["git"],
              "defaultWorkDir": "~/agents/claude-code"
            }
          }
        },
        "linux": {
          "recommended": "native",
          "choices": {
            "native": {
              "label": "原生安装",
              "command": "curl -fsSL https://claude.ai/install.sh | bash",
              "requires": ["git"],
              "defaultWorkDir": "~/agents/claude-code"
            }
          }
        }
      },
      "config": { "kind": "claude", "homeDir": "~/.claude", "providerCommand": null }
    },
